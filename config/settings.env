# ==========================================
# BASH BACKUP & RESTORE TOOL - CONFIGURATION
# ==========================================

# Local Paths
BACKUP_DEST="/home/kali/bash-backup-tool/backups"
LOG_FILE="/home/kali/bash-backup-tool/logs/backup_tool.log"
RETENTION_DAYS=30

# Remote Replication (Optional)
ENABLE_REMOTE_SYNC="false"
REMOTE_USER="remote_username"
REMOTE_HOST="remote_server_ip"
REMOTE_DIR="/path/to/remote/backups"

# Webhook Notifications (Optional)
ENABLE_WEBHOOK="false"
WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
